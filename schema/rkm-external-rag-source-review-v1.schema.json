{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/rkm-external-rag-source-review-v1.schema.json",
  "title": "RKM External RAG Source Review v1",
  "description": "A human review record for external RAG source metadata with an internal-evaluation-only scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "reviewId", "subjectBundle", "reviewer", "lifecycle", "sourceDecisions", "limitations"],
  "properties": {
    "contractVersion": { "const": "rkm-external-rag-source-review-v1" },
    "reviewId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subjectBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "version", "sha256"],
      "properties": {
        "bundleId": { "const": "nasa-space-exploration-rag-evidence-v1" },
        "version": { "const": "1.0.0" },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "scope": { "const": "INTERNAL_EVALUATION_ONLY" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewState", "productionPromotionAllowed"],
      "properties": {
        "status": { "const": "Reviewed" },
        "reviewState": { "const": "Human Reviewed" },
        "productionPromotionAllowed": { "const": false }
      }
    },
    "sourceDecisions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "decision", "basis"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "decision": { "const": "APPROVED" },
          "basis": { "type": "string", "minLength": 20 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10 }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
