{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/definitions/indexing.schema.json",
  "title": "RKM Indexing Definition",
  "description": "Defines a reusable embedded indexing profile for describing how source artifacts, chunks, embeddings, metadata and graph structures are transformed into queryable retrieval structures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indexingScope",
    "indexConfiguration",
    "freshnessPolicy"
  ],
  "properties": {
    "indexingId": {
      "type": "string",
      "description": "Stable local identifier for this indexing profile within the containing entity, workflow, evidence record or evaluation context.",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the indexing profile.",
      "minLength": 1
    },
    "indexingScope": {
      "$ref": "#/$defs/indexingScope"
    },
    "indexConfiguration": {
      "$ref": "#/$defs/indexConfiguration"
    },
    "metadataPropagation": {
      "type": "array",
      "description": "Metadata fields copied, transformed or derived during indexing.",
      "items": {
        "$ref": "#/$defs/metadataPropagationRule"
      },
      "uniqueItems": true
    },
    "freshnessPolicy": {
      "$ref": "#/$defs/freshnessPolicy"
    },
    "indexedArtifacts": {
      "type": "array",
      "description": "Artifacts produced or maintained by the indexing process.",
      "items": {
        "$ref": "artifact.schema.json"
      },
      "uniqueItems": true
    },
    "qualityAttributes": {
      "type": "array",
      "description": "Quality attributes affected by this indexing profile.",
      "items": {
        "$ref": "quality-attribute.schema.json"
      },
      "uniqueItems": true
    },
    "relationships": {
      "type": "array",
      "description": "First-class relationships connecting this indexing profile to existing RKM entities when those links have reusable semantic value.",
      "items": {
        "$ref": "relationship.schema.json"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "description": "Claims about retrieval quality, freshness, latency, cost, governance or reproducibility affected by this indexing profile.",
      "items": {
        "$ref": "claim.schema.json"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "description": "Evidence records supporting claims about this indexing profile.",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "description": "Structured sources that define, document or justify this indexing profile.",
      "items": {
        "$ref": "reference.schema.json"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "indexingScope": {
      "type": "object",
      "description": "Boundary of the content, transformations and storage targets covered by the indexing profile.",
      "additionalProperties": false,
      "required": [
        "sourceArtifactTypes",
        "indexedRepresentationTypes",
        "storageTargets"
      ],
      "properties": {
        "sourceArtifactTypes": {
          "type": "array",
          "description": "Types of source artifacts prepared for retrieval.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceArtifactType"
          },
          "uniqueItems": true
        },
        "indexedRepresentationTypes": {
          "type": "array",
          "description": "Retrieval-ready representations produced by indexing.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexedRepresentationType"
          },
          "uniqueItems": true
        },
        "storageTargets": {
          "type": "array",
          "description": "Storage systems, collections, namespaces or graph stores that maintain the indexed representation.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storageTarget"
          },
          "uniqueItems": true
        },
        "chunkingStrategy": {
          "$ref": "#/$defs/entityReference"
        },
        "embeddingModel": {
          "$ref": "#/$defs/entityReference"
        },
        "dependentRetrievers": {
          "type": "array",
          "description": "Retrievers that depend on this indexed representation.",
          "items": {
            "$ref": "#/$defs/entityReference"
          },
          "uniqueItems": true
        },
        "dependentWorkflows": {
          "type": "array",
          "description": "Workflows that depend on this indexed representation.",
          "items": {
            "$ref": "#/$defs/entityReference"
          },
          "uniqueItems": true
        }
      }
    },
    "sourceArtifactType": {
      "type": "string",
      "description": "Source artifact form accepted by the indexing process.",
      "enum": [
        "Document",
        "Web Page",
        "Markdown",
        "PDF",
        "HTML",
        "Dataset Record",
        "Database Record",
        "Code File",
        "Conversation",
        "Image",
        "Audio",
        "Video",
        "Knowledge Graph",
        "Other"
      ]
    },
    "indexedRepresentationType": {
      "type": "string",
      "description": "Retrieval-ready artifact produced or maintained by indexing.",
      "enum": [
        "Parsed Document",
        "Chunk",
        "Passage",
        "Dense Vector",
        "Sparse Vector",
        "Hybrid Vector",
        "Graph Node",
        "Graph Edge",
        "Metadata Record",
        "Citation Candidate",
        "Index Record",
        "Other"
      ]
    },
    "storageTarget": {
      "type": "object",
      "description": "Target where indexed representations are persisted or queried.",
      "additionalProperties": false,
      "required": [
        "targetType"
      ],
      "properties": {
        "targetType": {
          "type": "string",
          "enum": [
            "Vector Database",
            "Graph Database",
            "Search Index",
            "Relational Database",
            "Object Store",
            "File System",
            "Cache",
            "Memory",
            "Other"
          ]
        },
        "targetEntity": {
          "$ref": "#/$defs/entityReference"
        },
        "collection": {
          "type": "string",
          "description": "Collection, table, graph, bucket or index name when known.",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "description": "Namespace, tenant, partition or logical boundary used for indexed records.",
          "minLength": 1
        }
      }
    },
    "indexConfiguration": {
      "type": "object",
      "description": "Configuration choices that affect retrieval behavior, reproducibility, latency, cost or governance.",
      "additionalProperties": false,
      "required": [
        "indexType"
      ],
      "properties": {
        "indexType": {
          "type": "string",
          "enum": [
            "Flat",
            "Approximate Nearest Neighbor",
            "HNSW",
            "Inverted File",
            "Product Quantization",
            "Scalar Quantization",
            "Sparse Inverted Index",
            "Hybrid Sparse Dense",
            "Graph Index",
            "Keyword Index",
            "Other"
          ]
        },
        "similarityMetric": {
          "type": "string",
          "enum": [
            "Cosine",
            "Dot Product",
            "Euclidean",
            "Manhattan",
            "BM25",
            "Jaccard",
            "Graph Distance",
            "Custom",
            "Unknown"
          ]
        },
        "vectorDimension": {
          "type": "integer",
          "description": "Vector dimensionality when the index stores vector embeddings.",
          "minimum": 1
        },
        "filteringSupport": {
          "$ref": "#/$defs/filteringSupport"
        },
        "partitioning": {
          "$ref": "#/$defs/partitioning"
        },
        "deduplication": {
          "$ref": "#/$defs/deduplication"
        },
        "parameters": {
          "type": "array",
          "description": "Index parameters that materially affect behavior.",
          "items": {
            "$ref": "#/$defs/configurationParameter"
          },
          "uniqueItems": true
        }
      }
    },
    "filteringSupport": {
      "type": "object",
      "description": "Metadata, policy or access-control filtering behavior available during retrieval.",
      "additionalProperties": false,
      "properties": {
        "supportsMetadataFilters": {
          "type": "boolean",
          "default": false
        },
        "supportsAccessControlFilters": {
          "type": "boolean",
          "default": false
        },
        "filterLanguages": {
          "type": "array",
          "description": "Filter languages, operators or query forms supported by the index.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "partitioning": {
      "type": "object",
      "description": "Namespace, shard, tenant or collection layout for indexed data.",
      "additionalProperties": false,
      "properties": {
        "partitioningType": {
          "type": "string",
          "enum": [
            "None",
            "Namespace",
            "Tenant",
            "Collection",
            "Shard",
            "Time Window",
            "Source Type",
            "Access Scope",
            "Other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deduplication": {
      "type": "object",
      "description": "Behavior used to detect, merge or suppress duplicate indexed artifacts.",
      "additionalProperties": false,
      "required": [
        "deduplicationStrategy"
      ],
      "properties": {
        "deduplicationStrategy": {
          "type": "string",
          "enum": [
            "None",
            "Exact Match",
            "Content Hash",
            "Semantic Similarity",
            "Source Identifier",
            "Custom",
            "Unknown"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "configurationParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Stable parameter name.",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "value": {
          "description": "Parameter value expressed as JSON."
        },
        "unit": {
          "type": "string",
          "description": "Unit for numeric or duration values when relevant.",
          "minLength": 1
        }
      }
    },
    "metadataPropagationRule": {
      "type": "object",
      "description": "Rule describing how source metadata is preserved, transformed or derived during indexing.",
      "additionalProperties": false,
      "required": [
        "sourceField",
        "targetField",
        "propagationMode"
      ],
      "properties": {
        "sourceField": {
          "type": "string",
          "description": "Source metadata field or path.",
          "minLength": 1
        },
        "targetField": {
          "type": "string",
          "description": "Indexed metadata field or path.",
          "minLength": 1
        },
        "propagationMode": {
          "type": "string",
          "enum": [
            "Copied",
            "Transformed",
            "Derived",
            "Redacted",
            "Dropped"
          ]
        },
        "purpose": {
          "type": "string",
          "description": "Retrieval, citation, governance or operational purpose served by the propagated metadata.",
          "minLength": 1
        }
      }
    },
    "freshnessPolicy": {
      "type": "object",
      "description": "Refresh, reindexing, deletion and stale artifact handling for the indexed representation.",
      "additionalProperties": false,
      "required": [
        "updateStrategy",
        "deletionStrategy"
      ],
      "properties": {
        "updateStrategy": {
          "type": "string",
          "enum": [
            "Manual",
            "Scheduled",
            "Event Driven",
            "Incremental",
            "Full Reindex",
            "Continuous",
            "Static Corpus",
            "Unknown"
          ]
        },
        "updateCadence": {
          "type": "string",
          "description": "ISO 8601 duration, schedule name or documented refresh cadence.",
          "minLength": 1
        },
        "deletionStrategy": {
          "type": "string",
          "enum": [
            "Immediate Delete",
            "Soft Delete",
            "Tombstone",
            "Delayed Compaction",
            "Full Rebuild",
            "Not Supported",
            "Unknown"
          ]
        },
        "staleArtifactHandling": {
          "type": "string",
          "enum": [
            "Retain Until Refresh",
            "Exclude From Retrieval",
            "Mark Stale",
            "Replace Incrementally",
            "Rebuild Index",
            "Unknown"
          ]
        },
        "failureRecovery": {
          "type": "string",
          "description": "Recovery, retry or rollback behavior when indexing fails.",
          "minLength": 1
        }
      }
    },
    "entityReference": {
      "$ref": "entity-reference.schema.json"
    }
  }
}
