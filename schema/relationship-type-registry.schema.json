{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/relationship-type-registry.schema.json",
  "title": "RKM Relationship Type Registry Schema",
  "description": "Defines a registry document containing ontology relationship type definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "relationshipTypes"
  ],
  "properties": {
    "metadata": {
      "$ref": "definitions/metadata.schema.json"
    },
    "ontologyVersion": {
      "type": "string",
      "description": "Ontology version represented by this registry.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "relationshipTypes": {
      "type": "array",
      "description": "Registered relationship type definitions.",
      "minItems": 1,
      "items": {
        "$ref": "definitions/relationship-type.schema.json"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "description": "Registry-level notes.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
