{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/rkm-canonical-rag-evidence-projection-v1.schema.json",
  "title": "RKM Canonical RAG Evidence Projection v1",
  "description": "A deterministic, read-only projection envelope for reviewed RAG evidence. It is not a production policy or recommendation approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "projectionId",
    "lifecycle",
    "sourceBundle",
    "sourceReview",
    "entities",
    "relationships",
    "limitations"
  ],
  "properties": {
    "contractVersion": { "const": "rkm-canonical-rag-evidence-projection-v1" },
    "projectionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "sourceBundle": { "$ref": "#/$defs/boundArtifact" },
    "sourceReview": { "$ref": "#/$defs/boundArtifact" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relationship" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewState", "scope", "productionPromotionAllowed"],
      "properties": {
        "status": { "const": "Reviewed" },
        "reviewState": { "const": "Human Reviewed" },
        "scope": { "const": "INTERNAL_EVALUATION_ONLY" },
        "productionPromotionAllowed": { "const": false }
      }
    },
    "boundArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "bundleSha256", "reviewId", "reviewSha256", "reviewedAt", "reviewer", "scope"],
      "properties": {
        "bundleId": { "type": "string", "minLength": 1 },
        "bundleSha256": { "$ref": "#/$defs/sha256" },
        "reviewId": { "type": "string", "minLength": 1 },
        "reviewSha256": { "$ref": "#/$defs/sha256" },
        "reviewedAt": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 1 },
        "scope": { "const": "INTERNAL_EVALUATION_ONLY" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityType", "slug", "name", "status", "provenance", "attributes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{4,}$" },
        "entityType": {
          "enum": ["Reference", "Evidence", "Dataset", "Artifact", "Benchmark"]
        },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "const": "Reviewed" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sourceId", "sourceType", "targetId", "targetType", "status", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^RELATIONSHIP-[0-9]{4,}$" },
        "type": { "enum": ["REFERENCES", "VALIDATES", "EVALUATES"] },
        "sourceId": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{4,}$" },
        "sourceType": { "enum": ["Reference", "Evidence", "Dataset", "Artifact", "Benchmark"] },
        "targetId": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{4,}$" },
        "targetType": { "enum": ["Reference", "Evidence", "Dataset", "Artifact", "Benchmark"] },
        "status": { "const": "Reviewed" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
