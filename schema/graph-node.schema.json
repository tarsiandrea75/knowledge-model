{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/graph-node.schema.json",
  "title": "RKM Graph Export Node",
  "description": "Validates one graph export node object emitted by RKM graph export paths.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "label",
    "sourceDataFile",
    "properties"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "sourceDataFile": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
