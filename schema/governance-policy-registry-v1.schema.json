{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/governance-policy-registry-v1.schema.json",
  "title": "RKM Governance Policy Registry v1",
  "description": "Versioned policy-as-data records linking stable governance rules to their source files and executable checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "registryId", "registryVersion", "status", "policies"],
  "properties": {
    "contractVersion": { "const": "rkm-governance-policy-registry-v1" },
    "registryId": { "const": "rkm-core-governance-policies" },
    "registryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["Draft", "Review", "Published", "Deprecated"] },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "ruleId": { "type": "string", "pattern": "^RKM-GOV-[0-9]{3,}$" },
    "path": { "type": "string", "pattern": "^(?:AGENTS\\.md|[a-z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*)$" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "title",
        "area",
        "priority",
        "enforcementLevel",
        "status",
        "sourceFiles",
        "validators",
        "commands",
        "reviewOwner"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "title": { "type": "string", "minLength": 10 },
        "area": { "enum": ["Governance", "Validation", "Automation", "Modeling", "Evidence", "Release", "Tooling"] },
        "priority": { "enum": ["High", "Medium", "Low"] },
        "enforcementLevel": { "enum": ["Documented", "Partially Validated", "Validated", "Not Yet Automated", "Not Applicable"] },
        "status": { "enum": ["Proposed", "Planned", "In Progress", "Implemented", "Superseded", "Deferred"] },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "validators": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:make [a-z0-9_-]+|python3 scripts/[a-z0-9_.-]+\\.py(?: .*)?|bash scripts/[a-z0-9_.-]+\\.sh(?: .*)?)$" }
        },
        "reviewOwner": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enforcementLevel": { "const": "Validated" } } },
          "then": {
            "properties": {
              "validators": { "minItems": 1 },
              "commands": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
