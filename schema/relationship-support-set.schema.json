{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/relationship-support-set.schema.json",
  "title": "RKM Relationship Support Set Schema",
  "description": "Validates references, claims and evidence that support declared RKM relationship instances.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "description",
    "references",
    "claims",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions/reference.schema.json"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions/claim.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions/evidence.schema.json"
      }
    }
  }
}
