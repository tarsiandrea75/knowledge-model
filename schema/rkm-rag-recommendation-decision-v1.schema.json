{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rkm.org/schema/rkm-rag-recommendation-decision-v1.schema.json",
  "title": "RKM Review-Ready RAG Recommendation Decision v1",
  "description": "A non-production RKM decision record that preserves evaluation provenance and recommendation profiles without authorizing route promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "decisionId", "decisionType", "lifecycle", "sourceArtifact", "evaluationContext", "profiles"],
  "properties": {
    "contractVersion": { "const": "rkm-rag-recommendation-decision-v1" },
    "decisionId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "decisionType": { "const": "RAG_STRATEGY_RECOMMENDATION" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "sourceArtifact": { "$ref": "#/$defs/sourceArtifact" },
    "evaluationContext": { "$ref": "#/$defs/evaluationContext" },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["economical", "balanced", "maximumQuality"],
      "properties": {
        "economical": { "$ref": "#/$defs/recommendation" },
        "balanced": { "$ref": "#/$defs/recommendation" },
        "maximumQuality": { "$ref": "#/$defs/recommendation" }
      }
    }
  },
  "$defs": {
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewState", "productionPromotionAllowed"],
      "properties": {
        "status": { "const": "Draft" },
        "reviewState": { "const": "Not Reviewed" },
        "productionPromotionAllowed": { "const": false }
      }
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterContractVersion", "sourceContractVersion", "experimentId", "policyVersion", "artifactSha256"],
      "properties": {
        "adapterContractVersion": { "const": "rkm-recommendation-artifact-adapter-v1" },
        "sourceContractVersion": { "const": "rag-recommendation-report-v1" },
        "experimentId": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string", "minLength": 1 },
        "artifactSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "indexProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "configurationSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "configurationSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "evaluationContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus", "dataset", "indexProfiles", "pipelineCount"],
      "properties": {
        "corpus": { "$ref": "#/$defs/artifactReference" },
        "dataset": { "$ref": "#/$defs/artifactReference" },
        "indexProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/indexProfile" }, "uniqueItems": true },
        "pipelineCount": { "type": "integer", "minimum": 1 }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "available", "pipelineId", "qualityScore", "latencyP95Ms", "estimatedCost", "costCurrency", "reason"],
      "properties": {
        "profile": { "enum": ["ECONOMICAL", "BALANCED", "MAXIMUM_QUALITY"] },
        "available": { "type": "boolean" },
        "pipelineId": { "type": "string", "minLength": 0 },
        "indexProfileId": { "type": "string", "minLength": 1 },
        "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyP95Ms": { "type": "integer", "minimum": 0 },
        "estimatedCost": { "type": "number", "minimum": 0 },
        "costCurrency": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "available": { "const": true } } }, "then": { "properties": { "pipelineId": { "minLength": 1 } } } },
        { "if": { "properties": { "available": { "const": false } } }, "then": { "properties": { "pipelineId": { "const": "" } } } }
      ]
    }
  }
}
